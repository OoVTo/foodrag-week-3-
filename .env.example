# Upstash and Groq Configuration Template

# ==================== UPSTASH VECTOR ====================
# Get these credentials from: https://console.upstash.com/vector
# 1. Create a Vector Database in Upstash Console
# 2. Copy the REST API credentials

UPSTASH_VECTOR_REST_URL=https://your-vector-db.upstash.io
UPSTASH_VECTOR_REST_TOKEN=your_upstash_vector_token_here

# ==================== GROQ API ====================
# Get your API key from: https://console.groq.com/keys
# Sign up for free at: https://console.groq.com

GROQ_API_KEY=your_groq_api_key_here

# ==================== OPTIONAL ====================
# Uncomment and customize if needed

# LOG_LEVEL=INFO
# BATCH_SIZE=10
# TOP_K_RESULTS=3
