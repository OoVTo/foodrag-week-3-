# Upstash Vector Database Configuration
# Get these from https://upstash.com/
UPSTASH_VECTOR_REST_URL=https://your-db-name-us1-vector.upstash.io
UPSTASH_VECTOR_REST_TOKEN=ABC...your_token_here...XYZ

# Groq API Configuration  
# Get this from https://groq.com/
GROQ_API_KEY=gsk_...your_api_key_here...

# Application Settings (optional overrides)
VECTOR_INDEX_NAME=food-rag
LLM_MODEL=mixtral-8x7b-32768
EMBEDDING_DIMENSION=1024

# Note: Copy this file to .env and fill in your actual credentials
# IMPORTANT: NEVER commit .env to git - only .env.example should be in repo
